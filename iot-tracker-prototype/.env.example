# Thay IP bên dưới bằng IPv4 LAN của máy tính chạy backend (ipconfig trên Windows).
# Điện thoại thật và máy tính phải cùng Wi-Fi.
EXPO_PUBLIC_API_URL=http://192.168.1.161:4000/api

# Backend demo nhận mọi ID số nguyên dương; backend ConnectMyTask cần ID có thật.
EXPO_PUBLIC_DEMO_TASK_ID=1
EXPO_PUBLIC_DEMO_PROVIDER_ID=1
